{
  "name": "evolve-os",
  "productName": "Evolve OS",
  "version": "0.1.0",
  "description": "Evolve OS as its own Mac app",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/store.test.js && node test/shim.test.js && node test/google.test.js && node test/supabase.test.js && node test/evoldb.test.js && node test/automove.test.js && node test/board-updates.test.js && node test/capture.test.js && node test/ai.test.js && node test/engine.test.js",
    "dist:mac": "electron-builder --mac --publish never",
    "check": "node test/check/run.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "pg": "^8.13.1",
    "ws": "^8.22.1"
  },
  "build": {
    "appId": "com.evolveentertain.evolveos",
    "productName": "Evolve OS",
    "copyright": "Evolve Entertainment Studios",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "electronLanguages": [
      "en",
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EVOLVEENTERTAINMENT/INTERNAL.git"
  },
  "author": "Evolve Entertainment Studios",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  }
}
